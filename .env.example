# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/hrms_db"

# ── NextAuth ──────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-nextauth-key-change-this"
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth (optional) ───────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Email (Nodemailer) ────────────────────────────────────────
# For password reset emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="HRMS <noreply@yourcompany.com>"

# ── App Settings ──────────────────────────────────────────────
APP_NAME="Fiaxe HRM"
APP_URL="http://localhost:3000"

# ── Feature Flags ─────────────────────────────────────────────
# Set to "true" to enforce IP and geofence checks in development
ENFORCE_IP_CHECK="false"
ENFORCE_GEOFENCE="false"

# ── WhatsApp attendance notifications (Evolution API, direct) ──
# Sent straight from the app backend on check-in/check-out — no n8n involved.
# Enable/disable and edit the message templates from Admin > Office & Access > WhatsApp.
EVOLUTION_API_URL="https://evolution.yourdomain.com"
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE_NAME="deepak"
EVOLUTION_GROUP_JID="120363405425230906@g.us"
