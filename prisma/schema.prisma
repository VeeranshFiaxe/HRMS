generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  name                   String
  password               String?
  role                   UserRole                @default(EMPLOYEE)
  employmentType         EmploymentType          @default(FULL_TIME)
  department             String?
  designation            String?
  phone                  String?
  personalEmail          String?
  avatar                 String?
  joiningDate            DateTime                @default(now())
  exitDate               DateTime?               @db.Date
  emergencyContactName   String?
  emergencyContactNumber String?
  isActive               Boolean                 @default(true)
  googleId               String?                 @unique
  emailVerified          DateTime?
  resetToken             String?
  resetTokenExpiry       DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  timeFormat             String                  @default("24h")
  companyScheduleId      String?
  salaryRulesId          String?
  dateOfBirth            DateTime?               @db.Date
  probationMonths        Int?
  announcements          Announcement[]
  attendanceRecords      AttendanceRecord[]
  auditLogs              AuditLog[]
  documents              Document[]
  customSchedule         EmployeeSchedule?
  leaveBalances          LeaveBalance[]
  leaveRequests          LeaveRequest[]          @relation("UserLeaveRequests")
  onboardingForms        OnboardingForm[]
  regularizationRequests RegularizationRequest[]
  salaryRuleOverride     SalaryRuleOverride?
  sessions               Session[]
  companySchedule        CompanySchedule?        @relation(fields: [companyScheduleId], references: [id])
  salaryRules            SalaryRules?            @relation(fields: [salaryRulesId], references: [id])

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  rememberMe   Boolean  @default(false)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AttendanceRecord {
  id               String           @id @default(cuid())
  userId           String
  date             DateTime         @db.Date
  checkInAt        DateTime?
  checkOutAt       DateTime?
  checkInIp        String?
  checkOutIp       String?
  checkInLat       Float?
  checkInLng       Float?
  checkOutLat      Float?
  checkOutLng      Float?
  checkInIpValid   Boolean?
  checkInGeoValid  Boolean?
  checkOutIpValid  Boolean?
  checkOutGeoValid Boolean?
  status           AttendanceStatus @default(PRESENT)
  isLate           Boolean          @default(false)
  isHalfDay        Boolean          @default(false)
  lateMinutes      Int              @default(0)
  overriddenBy     String?
  overrideNote     String?
  overriddenAt     DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  hoursWorked      Float?
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("attendance_records")
}

model CompanySchedule {
  id                String   @id @default(cuid())
  name              String   @default("Default Schedule")
  startTime         String   @default("11:00")
  endTime           String   @default("18:00")
  lateAfter         String   @default("11:15")
  halfDayAfter      String   @default("14:00")
  monday            Boolean  @default(true)
  tuesday           Boolean  @default(true)
  wednesday         Boolean  @default(true)
  thursday          Boolean  @default(true)
  friday            Boolean  @default(true)
  saturday          Boolean  @default(false)
  sunday            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isDefault         Boolean  @default(false)
  overrideLateAfter Boolean  @default(false)
  users             User[]

  @@map("company_schedules")
}

model EmployeeSchedule {
  id                String   @id @default(cuid())
  userId            String   @unique
  startTime         String
  endTime           String
  lateAfter         String
  halfDayAfter      String
  monday            Boolean  @default(true)
  tuesday           Boolean  @default(true)
  wednesday         Boolean  @default(true)
  thursday          Boolean  @default(true)
  friday            Boolean  @default(true)
  saturday          Boolean  @default(false)
  sunday            Boolean  @default(false)
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  overrideLateAfter Boolean  @default(false)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employee_schedules")
}

model Holiday {
  id         String   @id @default(cuid())
  name       String
  date       DateTime @unique @db.Date
  isOptional Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("holidays")
}

model OfficeSettings {
  id              String   @id @default(cuid())
  name            String   @default("Main Office")
  latitude        Float    @default(0)
  longitude       Float    @default(0)
  radiusMeters    Float    @default(200)
  geofenceEnabled Boolean  @default(true)
  allowedIps      Json     @default("[]")
  ipCheckEnabled  Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  timezone        String   @default("Asia/Kolkata")

  whatsappNotifyEnabled     Boolean @default(false)
  whatsappCheckInTemplate   String  @default("✅ {name} checked in at {time}")
  whatsappCheckOutTemplate  String  @default("❌ {name} checked out at {time}")

  @@map("office_settings")
}

model AttendanceRules {
  id                          String   @id @default(cuid())
  lateStreakDays              Int      @default(3)
  lateStreakPenalty           String   @default("HALF_DAY")
  graceMinutes                Int      @default(0)
  autoAbsentAfter             String   @default("15:00")
  autoCheckoutAfter           String   @default("21:00")
  minHoursFullDay             Float    @default(7.5)
  minHoursHalfDay             Float    @default(4.0)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  regularizationLimitPerMonth Int      @default(3)

  @@map("attendance_rules")
}

model SalaryRules {
  id                     String   @id @default(cuid())
  halfDayDeductionFactor Float    @default(0.5)
  absentDeductionFactor  Float    @default(1.0)
  paidLeaveDaysPerMonth  Int      @default(1)
  note                   String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  baseSalary             Float    @default(0)
  isDefault              Boolean  @default(false)
  name                   String   @default("Default Salary Rule")
  lateDeductionFactor    Float    @default(0.33)
  users                  User[]

  @@map("salary_rules")
}

model SalaryRuleOverride {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  baseSalary             Float?
  halfDayDeductionFactor Float?
  absentDeductionFactor  Float?
  paidLeaveDaysPerMonth  Int?
  customFormula          String?
  note                   String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  lateDeductionFactor    Float?
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("salary_rule_overrides")
}

model LeaveRequest {
  id          String      @id @default(cuid())
  userId      String
  fromDate    DateTime    @db.Date
  toDate      DateTime    @db.Date
  reason      String?
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  adminNote   String?
  cancelledAt DateTime?
  cancelledBy String?
  isPaid      Boolean     @default(true)
  leaveType   LeaveType   @default(CASUAL)
  totalDays   Float       @default(1)
  session     LeaveSession @default(FULL_DAY)
  status      LeaveStatus @default(PENDING)
  user        User        @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

model RegularizationRequest {
  id         String               @id @default(cuid())
  userId     String
  date       DateTime             @db.Date
  checkInAt  DateTime?
  checkOutAt DateTime?
  reason     String
  status     RegularizationStatus @default(PENDING)
  adminNote  String?
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("regularization_requests")
}

model LeaveBalance {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  month     Int?
  allocated Float    @default(0)
  used      Float    @default(0)
  carried   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@map("leave_balances")
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  action      AuditAction
  description String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Announcement {
  id                String    @id @default(cuid())
  title             String
  content           String
  isActive          Boolean   @default(true)
  reflectOnCalendar Boolean   @default(false)
  eventDate         DateTime? @db.Date
  eventName         String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  pinnedUntil       DateTime?
  createdBy         User?     @relation(fields: [createdById], references: [id])

  @@map("announcements")
}

model InboxItem {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String?
  status      String   @default("PENDING")
  relatedId   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("inbox_items")
}

model OnboardingForm {
  id             String                 @id @default(cuid())
  title          String
  description    String?
  fields         Json
  status         OnboardingFormStatus   @default(DRAFT)
  googleSheetUrl String?
  createdById    String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  createdBy      User                   @relation(fields: [createdById], references: [id])
  submissions    OnboardingSubmission[]

  @@map("onboarding_forms")
}

model OnboardingSubmission {
  id             String           @id @default(cuid())
  formId         String
  candidateName  String
  candidateEmail String
  status         OnboardingStatus @default(PENDING)
  data           Json
  adminNotes     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  documents      Document[]
  form           OnboardingForm   @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@map("onboarding_submissions")
}

model Document {
  id           String                @id @default(cuid())
  name         String
  mimeType     String
  data         Bytes
  size         Int
  submissionId String?
  userId       String?
  docCategory  String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  submission   OnboardingSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user         User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model DocumentTemplate {
  id              String   @id @default(cuid())
  name            String
  employmentTypes Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("document_templates")
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AuditAction {
  CHECK_IN
  CHECK_OUT
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  PROFILE_UPDATE
  ADMIN_RULE_CHANGE
  SCHEDULE_UPDATE
  HOLIDAY_CREATE
  HOLIDAY_DELETE
  EMPLOYEE_CREATE
  EMPLOYEE_UPDATE
  EMPLOYEE_DELETE
  IP_SETTING_CHANGE
  GEOFENCE_CHANGE
  SALARY_RULE_CHANGE
  ATTENDANCE_OVERRIDE
  ANNOUNCEMENT_CREATE
  ANNOUNCEMENT_UPDATE
  ANNOUNCEMENT_DELETE
  LEAVE_REQUEST_CREATE
  LEAVE_REQUEST_APPROVE
  LEAVE_REQUEST_REJECT
  LEAVE_REQUEST_CANCEL
  REGULARIZATION_REQUEST_CREATE
  REGULARIZATION_REQUEST_APPROVE
  REGULARIZATION_REQUEST_REJECT
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERN
  CONTRACT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
  UNPAID
}

enum LeaveSession {
  FULL_DAY
  FIRST_HALF
  SECOND_HALF
}

enum RegularizationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum OnboardingFormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OnboardingStatus {
  PENDING
  APPROVED
  REJECTED
}
